# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# Precisa satisfazer a política de senha forte do SQL Server:
# mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.
SQLSERVER_SA_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=
