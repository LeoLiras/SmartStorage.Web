# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# Precisa satisfazer a política de senha forte do SQL Server:
# mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.
SQLSERVER_SA_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Chave usada para assinar/validar os JWT emitidos pela AuthenticationAPI.
JWT_SECRET=

# Credenciais SMTP usadas pela EmailAPI para enviar e-mails.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Quem recebe a notificacao de novo produto enviada pela EmailAPI.
EMAIL_DESTINATARIO=

# Chave da API do Google Gemini usada pela AIAPI (AiRepository lê via GOOGLE_API_KEY).
GOOGLE_API_KEY=

# Tag das imagens publicadas em hub.docker.com/u/lelep0 (latest ou o hash do commit).
IMAGE_TAG=latest
