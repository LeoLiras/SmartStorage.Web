@page "/products/insight"
@attribute [Authorize]

@using System.Globalization

@inject ApiExtensions api
@inject NavigationManager nav
@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAiService aiService
@inject IReportsService reportService
@inject IJSRuntime js


<div class="app-toolbar mt-2">
    <MudText Typo="Typo.h5" Class="app-page-title">Estatísticas</MudText>
    @if (sales is not null && !loading && sales.Count > 0)
    {
        <div class="app-toolbar-actions">
            <MudButton OnClick="ExportPdf" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Secondary" Disabled="loadingReport">PDF</MudButton>
            <MudButton OnClick="ExportExcel" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive" Color="Color.Secondary" Disabled="loadingReport">Excel</MudButton>
        </div>
    }
</div>

@if(sales is null || loading)
{
    <Loading Message="Carregando estatísticas..."></Loading>
}
else if(sales.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">Não há insights disponíveis.</MudAlert>
}
else
{
    <div class="app-busy-slot mt-3">
        @if (loadingReport)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" Class="app-busy" aria-label="Processando" />
        }
    </div>

    <div class="app-insights-grid mt-2">
        <section class="app-panel">
            <MudText Typo="Typo.subtitle1" Class="app-panel-title">Total vendido por mês (R$)</MudText>
            <MudChart ChartType="ChartType.Line" ChartSeries="@totalSalesSeries" XAxisLabels="@totalSalesXAxis" ChartOptions="@chartOptions" Width="100%" Height="320px" />
        </section>

        <section class="app-panel">
            <MudText Typo="Typo.subtitle1" Class="app-panel-title">Participação nas vendas do mês (%)</MudText>
            <MudChart ChartType="ChartType.Pie" InputData="@topTotalSaled.ToArray()" InputLabels="@topTotalSaledLabels.ToArray()" ChartOptions="@chartOptions" Width="100%" Height="300px" />
        </section>
    </div>

    <section class="app-panel app-chat mt-4">
        <MudText Typo="Typo.subtitle1" Class="app-panel-title">Pergunte à IA sobre as vendas</MudText>
        <div class="app-chat-messages" role="log" aria-live="polite">
            @foreach (var msg in chatMessages)
            {
                <MudChat ChatPosition="@msg.Position" Dense="true">
                    <MudAvatar Size="Size.Small" Class="@(msg.IsUser ? "app-chat-avatar-user" : "app-chat-avatar-ai")">
                        <MudIcon Icon="@(msg.IsUser ? Icons.Material.Outlined.Person : Icons.Material.Outlined.AutoAwesome)" Size="Size.Small" />
                    </MudAvatar>
                    <MudChatBubble Class="@(msg.IsUser ? "app-chat-bubble-user" : "app-chat-bubble-ai")">
                        <MudText Typo="Typo.body2" Class="app-chat-text">@msg.Text.Replace("* **", "-").Replace("**", "")</MudText>
                    </MudChatBubble>
                </MudChat>
            }
        </div>

        <div class="app-chat-input">
            <MudTextField @bind-Value="currentInput"
                          Placeholder="Digite sua pergunta..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth
                          Lines="1"
                          OnKeyDown="HandleKeyDown"/>

            <MudIconButton OnClick="SendMessage" Icon="@Icons.Material.Filled.Send" Variant="Variant.Filled" Color="Color.Primary" Disabled="loadingReport" aria-label="Enviar pergunta" />
        </div>
    </section>
}

@code {
    #region Properties

    List<SaleVO> sales = new();

    bool loading = false;
    bool loadingReport = false;

    //Total sales chart
    private List<ChartSeries> totalSalesSeries = new List<ChartSeries>();
    private string[] totalSalesXAxis = { };

    //Best-selling montlhy chart
    private List<double> topTotalSaled = new();
    private List<string> topTotalSaledLabels = new();

    //Chat
    private List<ChatMessage> chatMessages = new();
    private string currentInput = "";

    private readonly ChartOptions chartOptions = new()
    {
        ChartPalette = ["#6D4AFF", "#A78BFF", "#60A5FA", "#34D399", "#FBBF24", "#F87171"]
    };
    #endregion

    #region Events

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        if (app.Sales is null || app.Sales.Count() == 0)
            sales = await api.Get<SaleVO>();
        else
            sales = app.Sales;

        if (sales is null)
            return;

        //============================================ Total Saled Chart (R$) ============================================
        var totalSales = sales
            .Where(s => s.DateSale.Year.Equals(DateTime.Now.Year))
            .GroupBy(s => new { s.DateSale.Year, s.DateSale.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .ToList();

        totalSalesXAxis = totalSales
            .Select(g => new DateTime(g.Key.Year, g.Key.Month, 1)
            .ToString("MMM", new CultureInfo("pt-BR")))
            .ToArray();

        var totalSalesMonthly = totalSales
            .Select(g => g.Sum(x => (double)x.SaleTotal))
            .ToArray();

        totalSalesSeries = new List<ChartSeries>()
        {
            new ChartSeries()
            {
                Name = "Vendas (R$)",
                Data = totalSalesMonthly
            }
        };

        //============================================ Total Saled Chart (R$) ============================================
        var totalSaled = sales.Where(x => x.DateSale.Year == DateTime.Now.Year && x.DateSale.Month == DateTime.Now.Month).Sum(x => x.SaleTotal);

        var salesByProduct = sales
            .Where(x => x.DateSale.Year == DateTime.Now.Year && x.DateSale.Month == DateTime.Now.Month)
            .GroupBy(x => x.ProductName)
            .Select(g => new
            {
                Product = g.Key,
                Total = g.Sum(x => x.SaleTotal)
            })
            .OrderByDescending(x => x.Total)
            .ToList();

        var top5Saled = salesByProduct.Take(5).ToList();

        topTotalSaled = top5Saled
            .Select(x => Math.Round((double)((x.Total / totalSaled) * 100), 2))
            .ToList();

        topTotalSaledLabels = top5Saled
            .Select(x => x.Product)
            .ToList();

        var othersSaledTotal = salesByProduct
            .Skip(5)
            .Sum(x => (double)x.Total);

        if (othersSaledTotal > 0)
        {
            var total = Math.Round((othersSaledTotal / (double)totalSaled) * 100, 2);

            topTotalSaled.Add(total);
            topTotalSaledLabels.Add("Outros");
        }
        //============================================ Total Saled Chart (R$) ============================================

        chatMessages.Add(new ChatMessage { Text = "Olá, como posso ajudar?", IsUser = false });

        loading = false;
    }

    private async void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    #endregion

    #region Methods

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput))
            return;

        chatMessages.Add(new ChatMessage { Text = currentInput, IsUser = true });

        if(sales is not null)
        {
            loadingReport = true;

            //var aiResponse = await api.PostAnalyseAI($"Apenas texto, não utilize tabelas e separe em tópicos somente se necessário. Não cite os nomes dos campos e nem lucro bruto total. {currentInput}");

            try
            {
                var aiResponse = await aiService.CallAI($"Apenas texto, não utilize tabelas e separe em tópicos somente se necessário. Não cite os nomes dos campos e nem lucro bruto total. {currentInput}");

                chatMessages.Add(new ChatMessage { Text = aiResponse ?? "", IsUser = false });

                currentInput = "";
            }
            catch (ApiException ex)
            {
                await ShowDialog.ShowDialogAsync($"Erro consultando a IA.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
            }
            finally
            {
                loadingReport = false;
            }
        }
        else
        {
            chatMessages.Add(new ChatMessage { Text = "Desculpe-me, não há vendas para serem analisadas.", IsUser = false });
        }  
    }

    private async Task ExportExcel()
    {
        try
        {
            loadingReport = true;

            var report = await reportService.GenerateExcel();

            await js.InvokeVoidAsync(
                "downloadFile",
                $"Vendas {DateTime.Now.Month}-{DateTime.Now.Year}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                report
            );
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro gerando o Excel.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
        finally
        {
            loadingReport = false;
        }
    }

    private async Task ExportPdf()
    {
        try
        {
            loadingReport = true;

            var report = await reportService.GeneratePdf();

            await js.InvokeVoidAsync(
                "downloadFile",
                $"Vendas {DateTime.Now.Month}-{DateTime.Now.Year}.pdf",
                "application/pdf",
                report
            );
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro gerando o PDF.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
        finally
        {
            loadingReport = false;
        }
    }

    #endregion
    
}
