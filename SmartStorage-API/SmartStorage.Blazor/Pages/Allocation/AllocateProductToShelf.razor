@page "/product/allocation/{productId:int}"

@attribute [Authorize]

@inject ApiExtensions api
@inject NavigationManager nav
@inject ShowDialog ShowDialog
@inject VariablesExtensions app

<MudText Typo="Typo.h5" Class="app-page-title mt-2">Alocar produto para prateleira</MudText>

@if(product is null || loading)
{
    <Loading Message="Carregando..." Shape="ELoadingShape.Form"></Loading>
}
else if(enter is not null)
{
    <EditForm Model="enter" OnValidSubmit="AllocateProduct">
        <DataAnnotationsValidator />
        <MudGrid Spacing="4" Class="mt-1">
            @if (product.Volume is null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Este produto não tem volume cadastrado. Edite o produto e informe o volume antes de alocá-lo.</MudAlert>
                </MudItem>
            }
            <MudItem xs="12" md="8">
                <section class="app-panel">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="app-panel-title">@enter.ProductName</MudText>
                        <MudText Typo="Typo.body2" Class="app-muted">
                            @if (product.Volume is not null)
                            {
                                <span class="num">@product.Volume.Value.ToString("0.###", PtBr) L</span><span> por unidade · </span>
                            }
                            <span>entrada em </span><span class="num">@entryDate?.ToString("dd/MM/yyyy")</span>
                        </MudText>
                    </div>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="4">
                            <MudNumericField Label="Quantidade" @bind-Value="enter.ProductQuantity" For="(() => enter.ProductQuantity)" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField Format="F2" Label="Preço" @bind-Value="enter.ProductPrice" For="(() => enter.ProductPrice)" Variant="Variant.Outlined" />
                        </MudItem>
                        @if (product.Volume is not null)
                        {
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="decimal" Label="Volume necessário (L)" Value="RequiredVolume" Format="0.###" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudSelect T="int" @bind-Value="enter.ShelfId" Label="Prateleira" OpenIcon="@Icons.Material.Filled.Storefront" Variant="Variant.Outlined">
                                @if (shelves is not null)
                                {
                                    foreach (var shelf in shelves)
                                    {
                                        <MudSelectItem Value="@shelf.Id">@shelf.Name · @Occupancy(shelf)</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        @if (SelectedShelf?.Volume is not null)
                        {
                            <MudItem xs="12">
                                <div class="app-meter" role="img" aria-label="@($"{SelectedShelf.Name} com {Occupancy(SelectedShelf)}")">
                                    <i class="@(SelectedShelf.Occupancy >= 100 ? "app-meter-full" : "")" style="width: @(Math.Clamp(SelectedShelf.Occupancy ?? 0, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i>
                                </div>
                                <MudText Typo="Typo.caption" Class="app-muted">Teto útil: 90% de <span class="num">@SelectedShelf.Volume.Value.ToString("0.###", PtBr) L</span></MudText>
                            </MudItem>
                        }
                        @if (DoesNotFit)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">A @SelectedShelf.Name não comporta a alocação: são necessários @RequiredVolume.ToString("0.###", PtBr) L e restam @Math.Max(SelectedShelf.FreeVolume ?? 0, 0).ToString("0.###", PtBr) L.</MudAlert>
                            </MudItem>
                        }
                    </MudGrid>
                </section>
            </MudItem>
            <MudItem xs="12">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send">Alocar para venda</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {

    #region Properties

    [Parameter]
    public int productId { get; set; }

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private ProductVO product = new();
    private EnterVO enter = new();
    private List<ShelfVO> shelves = new();

    private DateTime? entryDate = DateTime.Today;

    bool loading = false;

    private ShelfVO SelectedShelf => shelves?.FirstOrDefault(s => s.Id == enter?.ShelfId);

    private decimal RequiredVolume => (enter?.ProductQuantity ?? 0) * (product?.Volume ?? 0);

    private bool DoesNotFit => product?.Volume is not null && SelectedShelf?.FreeVolume is not null && RequiredVolume > SelectedShelf.FreeVolume;

    #endregion

    #region Events

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            loading = true;

            if (productId != 0)
            {
                if (app.ActualProduct is null)
                    product = await api.GetById<ProductVO>(productId);
                else
                    product = app.ActualProduct;
            }

            shelves = await api.Get<ShelfVO>();

            app.Shelves = shelves;

            AtribuirDados();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Erro ao buscar produto.\n{ex.Message}", "Error", state: EDialogStates.Warning);

            nav.NavigateTo(app.productsInStockPage);
        }
    }

    #endregion

    #region Methods

    private async Task AllocateProduct()
    {
        try
        {
            loading = true;

            if (enter is null)
                return;

            var result = await api.Post<EnterVO>(enter);

            app.ProductEntries = await api.Get<EnterVO>();

            await ShowDialog.ShowDialogAsync("Produto alocado com sucesso", "Sucesso", app.productsInStockPage, EDialogStates.Success);

            StateHasChanged();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Erro atualizando o produto.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    private static string Occupancy(ShelfVO shelf)
    {
        if (shelf.Volume is null)
            return "sem volume cadastrado";

        return $"{shelf.Occupancy?.ToString("0", PtBr)}% ocupada · {Math.Max(shelf.FreeVolume ?? 0, 0).ToString("0.###", PtBr)} L livres";
    }

    private void AtribuirDados()
    {
        if (enter is null)
            enter = new();

        if(product is not null)
        {
            enter.ProductId = product.Id;
            enter.ProductName = product.Name;
        }

        enter.DateEnter = DateTime.Now;
    }

    #endregion

    

}
