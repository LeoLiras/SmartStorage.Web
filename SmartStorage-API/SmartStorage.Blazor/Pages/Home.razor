@page "/"

@inject ApiExtensions api
@inject VariablesExtensions app
@inject IAuthService auth
@inject AuthenticationStateProvider authProvider

@if (loading)
{
    <Loading Message="Carregando dados..." Shape="ELoadingShape.Cards"></Loading>
}
else
{
    <AuthorizeView Context="auth">
        <Authorized>
            <section class="app-welcome mt-2">
                <div class="app-welcome-heading">
                    <MudText Typo="Typo.h4" Class="app-page-title">Bem-vindo, @DisplayName(auth.User)</MudText>
                    @if (auth.User.IsInRole("Administrador"))
                    {
                        <span class="app-chip app-chip-primary">Administrador</span>
                    }
                    else
                    {
                        <span class="app-chip app-chip-neutral">Usuário</span>
                    }
                </div>
                <MudText Typo="Typo.body1" Class="app-muted app-welcome-text">Controle o estoque e as vendas com análises e projeções feitas por Inteligência Artificial.</MudText>
            </section>

            <nav class="app-shortcut-grid mt-6" aria-label="Atalhos">
                @foreach (var shortcut in Shortcuts)
                {
                    <a class="app-shortcut" href="@shortcut.Href">
                        <MudIcon Icon="@shortcut.Icon" Class="app-shortcut-icon" />
                        <span class="app-shortcut-title">@shortcut.Title</span>
                        <span class="app-shortcut-text">@shortcut.Description</span>
                    </a>
                }
            </nav>
        </Authorized>
        <NotAuthorized>
            <Login></Login>
        </NotAuthorized>
    </AuthorizeView>
}

@code {

    bool loading = false;

    private record Shortcut(string Href, string Icon, string Title, string Description);

    private static readonly Shortcut[] Shortcuts =
    [
        new("products", Icons.Material.Filled.Storage, "Produtos em estoque", "Veja os produtos, edite os dados e aloque para venda."),
        new("products/shelves", Icons.Material.Filled.Store, "Produtos nas prateleiras", "Venda, transfira ou devolva ao estoque o que está nas prateleiras."),
        new("products/sales", Icons.Material.Filled.AttachMoney, "Vendas", "Consulte as vendas, registre devoluções ou cancele."),
        new("products/insight", Icons.Material.Filled.Lightbulb, "Estatísticas", "Gráficos de vendas, relatórios e perguntas à IA."),
        new("user/account", Icons.Material.Filled.AccountCircle, "Conta", "Altere seus dados e, se for administrador, gerencie usuários."),
    ];

    private string DisplayName(System.Security.Claims.ClaimsPrincipal user)
        => !string.IsNullOrWhiteSpace(app.User?.FullName) ? app.User.FullName : user.FindFirst("unique_name")?.Value;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await authProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            loading = true;

            if (user.Identity!.IsAuthenticated)
            {
                if (app.ProductInStock?.Count == 0)
                    app.ProductInStock = await api.Get<ProductVO>();

                if (app.Employees?.Count == 0)
                    app.Employees = await api.Get<EmployeeVO>();

                if (app.Shelves?.Count == 0)
                    app.Shelves = await api.Get<ShelfVO>();

                if (app.ProductEntries?.Count == 0)
                    app.ProductEntries = await api.Get<EnterVO>();

                if (app.Sales?.Count == 0)
                    app.Sales = await api.Get<SaleVO>();

                if (app.User.Id == 0)
                    app.User = await auth.GetUser(user.FindFirst("unique_name")?.Value);

                StateHasChanged();
            }
        }
        catch (ApiException)
        {
            await auth.Logout();
        }
        finally
        {
            loading = false;
        }
    }
}


