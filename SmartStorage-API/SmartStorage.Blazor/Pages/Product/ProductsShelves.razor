@page "/products/shelves"
@attribute [Authorize]

@inject ApiExtensions api
@inject VariablesExtensions app
@inject NavigationManager nav
@inject ShowDialog ShowDialog

<MudTable @ref="table" T="EnterVO" Class="app-table mt-3" Elevation="0" ServerData="LoadEntries" Dense="false" Hover="true" Bordered="false" Striped="false" RowsPerPage="10">
    <ToolBarContent>
        <MudText Typo="Typo.h6" Class="app-page-title">Produtos nas prateleiras para venda</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="searchString" DebounceInterval="400" OnDebounceIntervalElapsed="Search" Placeholder="Pesquisar produto" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-search mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Produto</MudTh>
        <MudTh Class="app-cell-number">Preço</MudTh>
        <MudTh Class="app-cell-number">Quantidade</MudTh>
        <MudTh>Prateleira</MudTh>
        <MudTh>Data de entrada</MudTh>
        <MudTh><span class="app-visually-hidden">Ações</span></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Produto">@context.ProductName</MudTd>
        <MudTd DataLabel="Preço" Class="app-cell-number num">@context.ProductPrice.ToString("N2", PtBr)</MudTd>
        <MudTd DataLabel="Quantidade" Class="app-cell-number num">@context.ProductQuantity</MudTd>
        <MudTd DataLabel="Prateleira">@context.ShelfName</MudTd>
        <MudTd DataLabel="Data de entrada" Class="num">@context.DateEnter.ToString("dd/MM/yyyy HH:mm")</MudTd>
        <MudTd DataLabel="Ações" Class="app-cell-actions">
            <MudTooltip Text="Vender"><MudIconButton Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Success" aria-label="Vender" OnClick="@(() => SaleProduct(context))"></MudIconButton></MudTooltip>
            <MudTooltip Text="Transferir para outra prateleira"><MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Info" aria-label="Transferir para outra prateleira" OnClick="@(() => TransferProduct(context.Id))"></MudIconButton></MudTooltip>
            <MudTooltip Text="Enviar de volta para o estoque"><MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn" Color="Color.Warning" aria-label="Enviar de volta para o estoque" OnClick="@(() => UndoAllocation(context.Id))"></MudIconButton></MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="app-muted">@(string.IsNullOrWhiteSpace(searchString) ? "Não há produtos alocados para venda nas prateleiras." : "Nenhum produto encontrado nas prateleiras para a pesquisa.")</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <Loading Message="Carregando produtos nas prateleiras..."></Loading>
    </LoadingContent>
    <PagerContent>
        <MudTablePager HideRowsPerPage="true" />
    </PagerContent>
</MudTable>

@code {

    #region Properties

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private MudTable<EnterVO> table;

    string searchString = string.Empty;

    #endregion

    #region Methods

    private async Task<TableData<EnterVO>> LoadEntries(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var (items, total) = await api.GetPage<EnterVO>(state.Page + 1, state.PageSize, searchString);

            return new TableData<EnterVO> { Items = items, TotalItems = total };
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro ao buscar os produtos nas prateleiras.\n{ex.Message}", "Erro", state: EDialogStates.Warning);

            return new TableData<EnterVO> { Items = new List<EnterVO>(), TotalItems = 0 };
        }
    }

    private async Task Search(string text)
    {
        if (table.CurrentPage != 0)
            table.NavigateTo(0);
        else
            await table.ReloadServerData();
    }

    private async Task SaleProduct(EnterVO entry)
    {
        app.ActualEntry = entry;
        app.ActualProduct = await api.GetById<ProductVO>(entry.ProductId);

        nav.NavigateTo($"product/sale/{entry.Id}");
    }

    private void TransferProduct(int entryId)
    {
        nav.NavigateTo($"product/shelf/transfer/{entryId}");
    }

    private async Task UndoAllocation(int entryId)
    {
        try
        {
            var confimation = await ShowDialog.ShowDialogAsync("Tem certeza que deseja cancelar a alocação? O produto será devolvido ao estoque.", "Confirmação", state: EDialogStates.Warning, showCancel: true, showYes: true);

            if (confimation)
            {
                var entry = await api.GetById<EnterVO>(entryId);

                if (entry is null)
                    return;

                await api.Put<EnterVO>(entry, entryId);

                app.ProductEntries = new();

                await table.ReloadServerData();

                await ShowDialog.ShowDialogAsync("Alocação desfeita com sucesso.", "Sucesso", state: EDialogStates.Success);
            }
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro alocando o produto de volta para o estoque.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    #endregion
}
