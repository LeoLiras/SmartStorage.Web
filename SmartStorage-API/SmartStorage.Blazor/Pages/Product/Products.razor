@page "/products"
@attribute [Authorize]

@inject ApiExtensions api
@inject NavigationManager nav
@inject VariablesExtensions app
@inject ShowDialog ShowDialog

<div class="app-toolbar mt-2">
    <MudText Typo="Typo.h5" Class="app-page-title">Produtos em estoque</MudText>
    <div class="app-toolbar-actions">
        <MudTextField T="string" @bind-Value="searchString" DebounceInterval="400" OnDebounceIntervalElapsed="Search" Placeholder="Pesquisar produto" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-search mt-0"></MudTextField>
        @if (selected.Count > 0)
        {
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClearSelection">Limpar seleção</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Send" Color="Color.Secondary" OnClick="AllocateSelected">@($"Alocar selecionados ({selected.Count})")</MudButton>
        }
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Href="product/insert">Adicionar produto</MudButton>
    </div>
</div>

@if(loading)
{
    <Loading Message="Carregando produtos..." Shape="ELoadingShape.Cards"></Loading>
}
else if(products.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">@(string.IsNullOrWhiteSpace(searchString) ? "Não há produtos registrados no banco de dados." : "Nenhum produto encontrado para a pesquisa.")</MudAlert>
}
else
{
    <div class="app-card-grid mt-4">
        @foreach (var product in products)
        {
            <article class="@(selected.ContainsKey(product.Id) ? "app-product-card is-selected" : "app-product-card")">
                <div class="app-card-thumb">
                    <img src="@ProcessImage(product)" alt="" loading="lazy" />
                </div>
                <div class="app-card-body">
                    <MudText Typo="Typo.subtitle1" Class="app-card-title">@product.Name</MudText>
                    @if (!string.IsNullOrWhiteSpace(product.Descricao))
                    {
                        <MudText Typo="Typo.body2" Class="app-card-description">@product.Descricao</MudText>
                    }
                    <div class="app-card-stock">
                        <span>Estoque total <b class="num">@product.TotalQntd</b></span>
                        @if (product.MinimumStock > 0)
                        {
                            @if (product.TotalQntd < product.MinimumStock)
                            {
                                <span class="app-chip app-chip-warning">abaixo do mínimo @product.MinimumStock</span>
                            }
                            else
                            {
                                <span class="app-chip app-chip-success">acima do mínimo</span>
                            }
                        }
                    </div>
                    <div class="app-card-stock">
                        <span>Depósito <span class="num">@product.Qntd</span> · Prateleiras <span class="num">@product.ShelvesQntd</span></span>
                        @if (product.Volume is null)
                        {
                            <span class="app-chip app-chip-error">sem volume</span>
                        }
                        else
                        {
                            <span class="num">@product.Volume.Value.ToString("0.###", PtBr) L</span>
                        }
                    </div>
                </div>
                <div class="app-card-actions">
                    <MudCheckBox T="bool" Value="selected.ContainsKey(product.Id)" ValueChanged="@(value => ToggleSelection(product, value))" Label="Selecionar" Color="Color.Primary" Class="app-card-select" aria-label="@($"Selecionar {product.Name} para alocar em lote")" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => Edit(product)">Editar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="() => AllocateToShelf(product)" aria-label="@($"Alocar {product.Name} para prateleira")">Alocar</MudButton>
                </div>
            </article>
        }
    </div>

    <div class="d-flex justify-center mt-6">
        <MudPagination Color="Color.Primary" Count="PageCount" Selected="currentPage" SelectedChanged="ChangePage" />
    </div>
}

@code {

    #region Properties

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    List<ProductVO> products = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private int total = 0;
    private int request = 0;

    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)total / pageSize));

    string searchString = string.Empty;

    private Dictionary<int, ProductVO> selected = new();

    bool loading = false;

    #endregion

    #region Events

    protected override async Task OnInitializedAsync()
    {
        await GetProducts();
    }

    #endregion

    #region Methods

    private void Edit(ProductVO product)
    {
        app.ActualProduct = product;

        nav.NavigateTo($"product/edit/{product.Id}");
    }

    private void AllocateToShelf(ProductVO product)
    {
        app.ActualProduct = product;

        nav.NavigateTo($"product/allocation/{product.Id}");
    }

    private void ToggleSelection(ProductVO product, bool value)
    {
        if (value)
            selected[product.Id] = product;
        else
            selected.Remove(product.Id);
    }

    private void ClearSelection()
    {
        selected.Clear();
    }

    private void AllocateSelected()
    {
        nav.NavigateTo($"product/allocation/batch?ids={string.Join(",", selected.Keys)}");
    }

    private async Task GetProducts()
    {
        var thisRequest = ++request;

        loading = true;

        try
        {
            var (items, count) = await api.GetPage<ProductVO>(currentPage, pageSize, searchString);

            if (thisRequest != request)
                return;

            products = items;
            total = count;
        }
        catch (ApiException ex)
        {
            if (thisRequest != request)
                return;

            products = new();
            total = 0;

            await ShowDialog.ShowDialogAsync($"Erro ao buscar os produtos.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
        finally
        {
            if (thisRequest == request)
                loading = false;
        }
    }

    private async Task Search(string text)
    {
        currentPage = 1;

        await GetProducts();
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;

        await GetProducts();
    }

    private string ProcessImage(ProductVO product)
    {
        if (product.ProImage is null)
            return app.DefaultImage;

        string contentType = string.Empty;

        if (product.ProImage[0] == 0xFF && product.ProImage[1] == 0xD8)
            contentType = "jpeg";

        if (product.ProImage[0] == 0x89 && product.ProImage[1] == 0x50)
            contentType = "png";

        var base64 = Convert.ToBase64String(product.ProImage);
        return $"data:image/{contentType};base64,{base64}";
    }

    #endregion

}
