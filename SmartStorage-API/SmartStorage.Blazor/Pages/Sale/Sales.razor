@page "/products/sales"
@attribute [Authorize]

@inject ApiExtensions api
@inject ISaleService saleService
@inject NavigationManager nav
@inject VariablesExtensions app
@inject ShowDialog ShowDialog

<MudTable @ref="table" T="SaleVO" Class="app-table mt-3" Elevation="0" ServerData="LoadSales" Dense="false" Hover="true" Bordered="false" Striped="false" RowsPerPage="10">
    <ToolBarContent>
        <MudText Typo="Typo.h6" Class="app-page-title">Produtos vendidos</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="searchString" DebounceInterval="400" OnDebounceIntervalElapsed="Search" Placeholder="Pesquisar produto" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-search mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Produto</MudTh>
        <MudTh Class="app-cell-number">Preço</MudTh>
        <MudTh Class="app-cell-number">Quantidade</MudTh>
        <MudTh Class="app-cell-number">Total</MudTh>
        <MudTh>Prateleira</MudTh>
        <MudTh>Data da venda</MudTh>
        <MudTh><span class="app-visually-hidden">Ações</span></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Produto">@context.ProductName</MudTd>
        <MudTd DataLabel="Preço" Class="app-cell-number num">@context.SalePrice.ToString("N2", PtBr)</MudTd>
        <MudTd DataLabel="Quantidade" Class="app-cell-number num">@context.NetQntd</MudTd>
        <MudTd DataLabel="Total" Class="app-cell-number num">@context.SaleTotal.ToString("N2", PtBr)</MudTd>
        <MudTd DataLabel="Prateleira">@context.ShelfName</MudTd>
        <MudTd DataLabel="Data da venda" Class="num">@context.DateSale.ToString("dd/MM/yyyy HH:mm")</MudTd>
        <MudTd DataLabel="Ações" Class="app-cell-actions">
            <MudTooltip Text="Registrar devolução"><MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn" Color="Color.Info" aria-label="Registrar devolução" OnClick="@(() => ReturnSale(context.Id))"></MudIconButton></MudTooltip>
            <MudTooltip Text="Cancelar venda"><MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Warning" aria-label="Cancelar venda" OnClick="@(() => CancelSale(context.Id))"></MudIconButton></MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="app-muted">@(string.IsNullOrWhiteSpace(searchString) ? "Não há produtos vendidos." : "Nenhuma venda encontrada para a pesquisa.")</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <Loading Message="Carregando produtos vendidos..."></Loading>
    </LoadingContent>
    <PagerContent>
        <MudTablePager HideRowsPerPage="true" />
    </PagerContent>
</MudTable>

@code {

    #region Properties

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private MudTable<SaleVO> table;

    string searchString = string.Empty;

    #endregion

    #region Methods

    private async Task<TableData<SaleVO>> LoadSales(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var (items, total) = await saleService.GetSalesPage(state.Page + 1, state.PageSize, searchString);

            return new TableData<SaleVO> { Items = items, TotalItems = total };
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro ao buscar as vendas.\n{ex.Message}", "Erro", state: EDialogStates.Warning);

            return new TableData<SaleVO> { Items = new List<SaleVO>(), TotalItems = 0 };
        }
    }

    private async Task Search(string text)
    {
        if (table.CurrentPage != 0)
            table.NavigateTo(0);
        else
            await table.ReloadServerData();
    }

    private void ReturnSale(int saleId)
    {
        nav.NavigateTo($"product/sale/return/{saleId}");
    }

    private async Task CancelSale(int saleId)
    {
        try
        {
            var dialogConfirmmation = await ShowDialog.ShowDialogAsync("Tem certeza que deseja cancelar a venda? A quantidade dos produtos será acrescida nas entradas.", "Confirmação", state: EDialogStates.Error, showCancel: true, showYes: true);

            if (dialogConfirmmation)
            {
                await saleService.CancelSale(saleId);

                app.Sales = new();

                app.ProductEntries = await api.Get<EnterVO>();

                await table.ReloadServerData();

                await ShowDialog.ShowDialogAsync("Venda cancelada com sucesso.", "Sucesso", app.productsSalesPage, EDialogStates.Success);
            }
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro cancelando a venda.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    #endregion
}
