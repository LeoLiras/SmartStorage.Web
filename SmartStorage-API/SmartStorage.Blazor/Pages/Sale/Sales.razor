@page "/products/sales"
@attribute [Authorize]

@inject ApiExtensions api
@inject NavigationManager nav
@inject VariablesExtensions app
@inject ShowDialog ShowDialog

<MudTable @ref="table" T="SaleVO" Class="mt-3" ServerData="LoadSales" Dense="false" Hover="true" Bordered="false" Striped="true" RowsPerPage="10">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Produtos Vendidos</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="searchString" DebounceInterval="400" OnDebounceIntervalElapsed="Search" Placeholder="Pesquisar Produto" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Produto</MudTh>
        <MudTh>Preço</MudTh>
        <MudTh>Quantidade</MudTh>
        <MudTh>Total</MudTh>
        <MudTh>Prateleira</MudTh>
        <MudTh>Data de Venda</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Produto">@context.ProductName</MudTd>
        <MudTd DataLabel="Preco">@context.SalePrice</MudTd>
        <MudTd DataLabel="Quantidade">@context.NetQntd</MudTd>
        <MudTd DataLabel="Total">@context.SaleTotal</MudTd>
        <MudTd DataLabel="Prateleira">@context.ShelfName</MudTd>
        <MudTd DataLabel="Data de Entrada">@context.DateSale.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
        <MudTd DataLabel="Devolver"><MudTooltip Text="Registrar devolução"><MudIconButton Icon="@Icons.Material.Filled.AssignmentReturn" Color="Color.Info" OnClick="@(() => ReturnSale(context.Id))"></MudIconButton></MudTooltip></MudTd>
        <MudTd DataLabel="Cancelar venda"><MudTooltip Text="Cancelar venda"><MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Warning" OnClick="@(() => CancelSale(context.Id))"></MudIconButton></MudTooltip></MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@(string.IsNullOrWhiteSpace(searchString) ? "Não há produtos vendidos." : "Nenhuma venda encontrada para a pesquisa.")</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Carregando produtos vendidos...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager HideRowsPerPage="true" />
    </PagerContent>
</MudTable>

@code {

    #region Properties

    private MudTable<SaleVO> table;

    string searchString = string.Empty;

    #endregion

    #region Methods

    private async Task<TableData<SaleVO>> LoadSales(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var (items, total) = await api.GetPage<SaleVO>(state.Page + 1, state.PageSize, searchString);

            return new TableData<SaleVO> { Items = items, TotalItems = total };
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro ao buscar as vendas.\n{ex.Message}", "Erro", state: EDialogStates.Warning);

            return new TableData<SaleVO> { Items = new List<SaleVO>(), TotalItems = 0 };
        }
    }

    private async Task Search(string text)
    {
        if (table.CurrentPage != 0)
            table.NavigateTo(0);
        else
            await table.ReloadServerData();
    }

    private void ReturnSale(int saleId)
    {
        nav.NavigateTo($"product/sale/return/{saleId}");
    }

    private async Task CancelSale(int saleId)
    {
        try
        {
            var dialogConfirmmation = await ShowDialog.ShowDialogAsync("Tem certeza que deseja cancelar a venda? A quantidade dos produtos será acrescida nas entradas.", "Confirmação", state: EDialogStates.Error, showCancel: true, showYes: true);

            if (dialogConfirmmation)
            {
                await api.Delete<SaleVO>(saleId);

                app.Sales = new();

                app.ProductEntries = await api.Get<EnterVO>();

                await table.ReloadServerData();

                await ShowDialog.ShowDialogAsync("Venda cancelada com sucesso.", "Sucesso", app.productsSalesPage, EDialogStates.Success);
            }
        }
        catch (ApiException ex)
        {
            await ShowDialog.ShowDialogAsync($"Erro cancelando a venda.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    #endregion
}
