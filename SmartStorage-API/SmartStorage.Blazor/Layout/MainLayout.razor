@inherits LayoutComponentBase
@using System.Security.Claims
@inject NavigationManager nav

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<SessionExpiredWatcher />
<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Abrir ou fechar o menu" OnClick="@((e) => DrawerToggle())" />
        <span class="brand ml-2"><i class="brand-mark"></i>Smart Storage</span>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <CartIndicator />
                <span class="app-user">@context.User.FindFirst("unique_name")?.Value · @context.User.FindFirst(ClaimTypes.Role)?.Value</span>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4">
        <div class="page-enter" @key="CurrentPath">
            @Body
        </div>
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] Manrope = ["Manrope", "system-ui", "-apple-system", "Segoe UI", "sans-serif"];

    private bool _drawerOpen = true;
    private MudTheme _theme = null;

    private string CurrentPath => new Uri(nav.Uri).AbsolutePath;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" }
        };

        var typography = _theme.Typography;
        BaseTypography[] styles =
        [
            typography.Default, typography.H1, typography.H2, typography.H3, typography.H4, typography.H5, typography.H6,
            typography.Subtitle1, typography.Subtitle2, typography.Body1, typography.Body2,
            typography.Button, typography.Caption, typography.Overline
        ];
        foreach (var style in styles)
            style.FontFamily = Manrope;

        typography.Button.TextTransform = "none";
        typography.Button.FontWeight = "700";
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private readonly PaletteDark _darkPalette = new()
    {
        Black = "#07080F",
        Dark = "#0C1224",
        Primary = "#6D4AFF",
        PrimaryContrastText = "#FFFFFF",
        PrimaryDarken = "#5A37F0",
        PrimaryLighten = "#A78BFF",
        Secondary = "#A78BFF",
        SecondaryContrastText = "#07080F",
        Tertiary = "#6D4AFF",
        TertiaryContrastText = "#FFFFFF",
        Info = "#60A5FA",
        InfoContrastText = "#07080F",
        Success = "#34D399",
        SuccessContrastText = "#07080F",
        Warning = "#FBBF24",
        WarningContrastText = "#07080F",
        Error = "#F87171",
        ErrorContrastText = "#07080F",
        Background = "#07080F",
        BackgroundGray = "#0C1224",
        Surface = "#121A33",
        AppbarBackground = "rgba(12,18,36,0.86)",
        AppbarText = "#E7E9F5",
        DrawerBackground = "#0C1224",
        DrawerText = "#9BA3C4",
        DrawerIcon = "#A78BFF",
        ActionDefault = "#A78BFF",
        ActionDisabled = "rgba(155,163,196,0.38)",
        ActionDisabledBackground = "rgba(36,48,86,0.6)",
        TextPrimary = "#E7E9F5",
        TextSecondary = "#9BA3C4",
        TextDisabled = "rgba(231,233,245,0.38)",
        LinesDefault = "#243056",
        LinesInputs = "#5B6690",
        TableLines = "#243056",
        TableHover = "#1A2446",
        TableStriped = "rgba(26,36,70,0.5)",
        Divider = "#243056",
        DividerLight = "rgba(36,48,86,0.6)",
        Skeleton = "#1A2446",
        GrayLight = "#1A2446",
        GrayLighter = "#121A33",
        OverlayDark = "rgba(7,8,15,0.7)",
        OverlayLight = "rgba(18,26,51,0.5)",
    };
}
