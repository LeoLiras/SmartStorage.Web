              "mode": "raw",
              "raw": "{\n  \"id\": {{newUserId}},\n  \"username\": \"postman.exemplo\",\n  \"password\": \"Exemplo456\",\n  \"fullName\": \"Usuário de Exemplo Atualizado\",\n  \"useType\": 0\n}",
