  "item": [
    {
      "name": "Autenticação",
      "description": "Usuários e login. Rode \"Entrar\" primeiro: as demais requisições usam o token que ela guarda.",
      "item": [
        {
          "name": "Entrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/v1/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "v1",
                "signin"
              ]
            },
            "description": "Autentica com o usuário e a senha do ambiente e guarda o token de acesso na variável accessToken da coleção. O token vale 60 minutos; depois disso, rode de novo. Papel exigido: nenhum, a rota é anônima.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
