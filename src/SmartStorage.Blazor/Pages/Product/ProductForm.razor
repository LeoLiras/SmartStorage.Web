@inject IEmployeeService employeeService
@inject IProductService productService
@inject NavigationManager nav
@inject ShowDialog ShowDialog
@inject VariablesExtensions app

@if (loading)
{
    <Loading Message="Carregando produto..." Shape="ELoadingShape.Form"></Loading>
}
else if(product is not null)
{
    <EditForm Model="product" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />
        <MudGrid Spacing="4" Class="mt-1">
            <MudItem xs="12" md="8">
                <section class="app-panel">
                    <MudText Typo="Typo.subtitle1" Class="app-panel-title">Dados do produto</MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Nome do Produto" @bind-Value="product.Name" For="@(() => product.Name)" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <EmployeeSelect @bind-Value="product.EmployeeId" Employees="employees" ReadOnly="ReadOnly" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Código de barras" @bind-Value="product.Codigo" For="@(() => product.Codigo)" InputMode="InputMode.numeric" MaxLength="14" HelperText="EAN/GTIN do fabricante" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="Descrição" @bind-Value="product.Descricao" For="@(() => product.Descricao)" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </section>

                <section class="app-panel mt-4">
                    <MudText Typo="Typo.subtitle1" Class="app-panel-title">Estoque</MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" lg="4">
                            @if (ProductId == 0)
                            {
                                <MudNumericField Label="Quantidade" @bind-Value="product.Qntd" For="(() => product.Qntd)" Variant="Variant.Outlined" />
                            }
                            else
                            {
                                <MudNumericField T="int" Label="Quantidade no depósito" Value="product.Qntd" ReadOnly="true" Variant="Variant.Outlined" />
                            }
                        </MudItem>
                        @if (ProductId != 0)
                        {
                            <MudItem xs="12" sm="6" lg="4">
                                <MudNumericField T="int" Label="Total (depósito + prateleiras)" Value="product.TotalQntd" ReadOnly="true" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                        <MudItem xs="12" sm="6" lg="4">
                            <MudDatePicker Label="Data de registro" @bind-Date="productDate" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" lg="4">
                            <MudNumericField T="int" Label="Estoque mínimo" @bind-Value="product.MinimumStock" For="(() => product.MinimumStock)" Min="0" HelperText="0 desativa o aviso por e-mail" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" lg="4">
                            <MudNumericField T="decimal?" Label="Volume (L)" @bind-Value="product.Volume" For="(() => product.Volume)" Min="0.001m" Format="0.###" HelperText="Obrigatório para alocar em prateleira" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" lg="4">
                            <MudNumericField T="decimal?" Label="Preço inicial" @bind-Value="product.PrecoInicial" For="(() => product.PrecoInicial)" Min="0.01m" Format="F2" HelperText="Preço padrão ao alocar em prateleira" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6" lg="4">
                            <MudNumericField T="int" Label="Fator de conversão" @bind-Value="product.FatorConversao" For="(() => product.FatorConversao)" Min="1" HelperText="Unidades de estoque por unidade da nota fiscal" ReadOnly="ReadOnly" Variant="Variant.Outlined" />
                        </MudItem>
                        @if (ProductId != 0)
                        {
                            <MudItem xs="12" sm="6" lg="4">
                                <MudTextField T="string" Label="Custo médio" Value="@(product.Custo?.ToString("N2", PtBr) ?? "Sem custo")" ReadOnly="true" HelperText="Calculado pelas notas fiscais importadas" Variant="Variant.Outlined" />
                            </MudItem>
                        }
                    </MudGrid>
                </section>

                @if (ProductId != 0 && !ReadOnly)
                {
                    <section class="app-panel mt-4">
                        <MudText Typo="Typo.subtitle1" Class="app-panel-title">Ajustar estoque do depósito</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="int" Label="Saldo real conferido" @bind-Value="adjustQuantity" Min="0" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="8">
                                <MudTextField T="string" Label="Motivo" @bind-Value="adjustReason" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </section>
                }
            </MudItem>

            <MudItem xs="12" md="4">
                <section class="app-panel">
                    <MudText Typo="Typo.subtitle1" Class="app-panel-title">Imagem</MudText>
                    <ProductImagePicker @bind-Image="product.ProImage" AltText="@($"Imagem de {product.Name}")" ReadOnly="ReadOnly" />
                </section>
            </MudItem>

            @ChildContent

            <MudItem xs="12">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@(SubmitText ?? (ProductId != 0 ? "Atualizar" : "Criar"))</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {

    #region Properties

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    [Parameter]
    public int ProductId { get; set; }

    [Parameter]
    public EventCallback<ProductVO> OnSave { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string SubmitText { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private ProductVO product = new();
    private List<EmployeeVO> employees = new();

    private DateTime? productDate = DateTime.Today;

    private int adjustQuantity;
    private string adjustReason;

    bool loading = false;

    private int? loadedProductId;

    #endregion

    #region Events

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProductId == ProductId)
            return;

        try
        {
            loading = true;

            if (app.Employees.Count == 0)
                employees = await employeeService.GetEmployees();
            else
                employees = app.Employees;


            if(ProductId != 0)
            {
                if (app.ActualProduct is not null && app.ActualProduct.Id == ProductId)
                    product = app.ActualProduct;
                else
                    product = await productService.GetProductById(ProductId);

                adjustQuantity = product.Qntd;
            }

            loadedProductId = ProductId;

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Erro ao buscar produto.\n{ex.Message}", "Error", state: EDialogStates.Warning);

            nav.NavigateTo(app.productsInStockPage);
        }
    }

    private async Task OnValidSubmit()
    {
        product.StockAdjustment = null;

        if (ProductId != 0 && !ReadOnly && adjustQuantity != product.Qntd)
        {
            var adjustment = new StockAdjustmentVO
            {
                Quantity = adjustQuantity,
                Reason = adjustReason
            };

            var errors = new List<System.ComponentModel.DataAnnotations.ValidationResult>();

            if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(adjustment, new System.ComponentModel.DataAnnotations.ValidationContext(adjustment), errors, validateAllProperties: true))
            {
                await ShowDialog.ShowDialogAsync($"Ajuste de estoque inválido.\n{string.Join("\n", errors.Select(e => e.ErrorMessage))}", "Erro", state: EDialogStates.Warning);

                return;
            }

            product.StockAdjustment = adjustment;
        }

        await OnSave.InvokeAsync(product);
    }

    #endregion

}
