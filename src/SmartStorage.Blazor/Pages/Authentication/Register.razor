@page "/user/register"
@attribute [Authorize(Roles = "Administrador")]

@using System.Text.RegularExpressions
@using SmartStorage.Shared.Enum
@using SmartStorage.Shared.VO

@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAuthService auth;

<MudText Typo="Typo.h5" Class="app-page-title mt-2">Cadastrar usuário</MudText>

@if (loading)
{
    <Loading Message="Cadastrando..." Shape="ELoadingShape.Form"></Loading>
}
else
{
    <section class="app-panel app-form-narrow mt-4">
        <MudForm Model="accountCredentials">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="accountCredentials.Fullname" T="string" Label="Nome Completo" Required="true" RequiredError="O Nome é obrigatório!" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="accountCredentials.Username" T="string" Label="Login" Required="true" RequiredError="O Login é obrigatório!" Variant="Variant.Outlined" />
                </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="accountCredentials.Password" T="string" Label="Senha" HelperText="Ao menos 8 caracteres, com maiúscula, minúscula e número." @ref="pwField1"
                                      InputType="InputType.Password"
                                      Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" Required="true"
                                      RequiredError="A senha é obrigatória!" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Confirmar Senha" HelperText="Repita a senha." InputType="InputType.Password"
                                      Validation="@(new Func<string, string>(PasswordMatch))" Variant="Variant.Outlined" />
                    </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="app-muted">Tipo da conta</MudText>
                    <MudRadioGroup @bind-Value="accountCredentials.Type" T="TipoUsuario" Required="true" RequiredError="O Tipo da Conta é obrigatório!">
                        <MudRadio Value=TipoUsuario.Usuario Color="Color.Primary">Usuário</MudRadio>
                        <MudRadio Value=TipoUsuario.Administrador Color="Color.Primary">Administrador</MudRadio>
                    </MudRadioGroup>
                </MudItem>
                <MudItem xs="12">
                    <MudButton OnClick="RegisterNewUser" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">Cadastrar</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </section>
}

@code {

    #region Properties

    bool loading = false;
    MudTextField<string> pwField1;
    AccountCredentialsVO accountCredentials = new();

    #endregion

    #region Methods

    private async void RegisterNewUser()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(accountCredentials.Username) 
                    || string.IsNullOrWhiteSpace(accountCredentials.Password) 
                    || string.IsNullOrWhiteSpace(accountCredentials.Fullname))
                return;

            loading = true;

            var result = await auth.RegisterUser(accountCredentials);

            await auth.Logout();

            await ShowDialog.ShowDialogAsync("Cadastro realizado com sucesso.", "Sucesso", "/", EDialogStates.Success);

            StateHasChanged();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Falha ao cadastrar novo usuário.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "A Senha é obrigatória!";
            yield break;
        }

        if (pw.Length < 8)
            yield return "A senha deve ter ao menos 8 caracteres";

        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "A senha deve ter ao menos uma letra maiúscula";

        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "A senha deve ter ao menos uma letra minúscula";

        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "A senha deve ter ao menos um dígito numérico";
    }

    private string PasswordMatch(string arg)
    {
        if (pwField1.Value != arg)
            return "As senhas não conferem";

        return null;
    }

    #endregion
   
}