@page "/user/account"

@attribute [Authorize]

@using System.Security.Claims

@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAuthService auth
@inject NavigationManager nav
@inject AuthenticationStateProvider authProvider

<div class="app-toolbar mt-2">
    <MudText Typo="Typo.h5" Class="app-page-title">Conta</MudText>
    @if (!loading && app.User.Id != 0)
    {
        <MudButton OnClick="Logout" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout">Sair</MudButton>
    }
</div>

@if(loading || app.User.Id == 0)
{
    <Loading Message="Carregando..." Shape="ELoadingShape.Form"></Loading>
}
else
{
    <EditUser UserId="app.User.Id"></EditUser>

    @if (isAdm)
    {
        <MudText Typo="Typo.h6" Class="app-page-title mt-8">Usuários</MudText>

        @if (usersList.Count == 0)
        {
            <MudText Class="app-muted mt-2">Nenhum outro usuário cadastrado.</MudText>
        }
        else
        {
            <div class="app-card-grid mt-4">
                @foreach (var user in PagedUsers)
                {
                    <article class="app-product-card app-user-card">
                        <div class="app-card-body">
                            <MudText Typo="Typo.subtitle1" Class="app-card-title">@user.FullName</MudText>
                            <div class="app-card-stock">
                                <span class="num">@user.Username</span>
                                @if (user.UseType == 0)
                                {
                                    <span class="app-chip app-chip-neutral">Usuário</span>
                                }
                                else
                                {
                                    <span class="app-chip app-chip-primary">Administrador</span>
                                }
                            </div>
                        </div>
                        <div class="app-card-actions">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Secondary" OnClick="() => Edit(user.Id)">Editar</MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Delete(user.Id)" aria-label="@($"Excluir {user.FullName}")">Excluir</MudButton>
                        </div>
                    </article>
                }
            </div>

            @if (usersList.Count > pageSize)
            {
                <div class="d-flex justify-center mt-6">
                    <MudPagination Color="Color.Primary" Count="(int)Math.Ceiling((double)usersList.Count / (double)pageSize)" Selected="currentPage" SelectedChanged="ChangePage" />
                </div>
            }
        }
    }
}

@code {

    #region Propreties

    private List<User> usersList = new();

    bool loading = false;
    bool isAdm = false;

    private int currentPage = 1;
    private int pageSize = 10;

    private IEnumerable<User> PagedUsers => usersList == null ? Enumerable.Empty<User>() : usersList.Skip((currentPage - 1) * pageSize).Take(pageSize);

    #endregion

    #region Events

    protected override async Task OnInitializedAsync()
    {
        var authState = await authProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (app.User.Id == 0)
            app.User = await auth.GetUser(user.FindFirst("unique_name")?.Value);

        isAdm = user?.FindFirst(ClaimTypes.Role)?.Value == "Administrador" ? true : false;

        if (isAdm)
            usersList = await GetUsers();
    }
    #endregion

    #region Methods

    private void Edit(long userId)
    {
        nav.NavigateTo($"user/edit/{userId}");
    }

    private async void Delete(long userId)
    {
        try
        {
            var confirmation = await ShowDialog.ShowDialogAsync("Tem certeza que deseja deletar esse usuário?", "Confirmação", state:EDialogStates.Warning, showCancel: true, showYes: true);

            if (!confirmation)
                return;

            loading = true;

            await auth.DeleteUser((int)userId);

            await ShowDialog.ShowDialogAsync("Usuário deletado com sucesso.", title:"Sucesso", state:EDialogStates.Success);

            usersList = await GetUsers();

            StateHasChanged();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Falha deletando o usuário\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    private async void Logout()
    {
        app.User = new();

        await auth.Logout();

        await ShowDialog.ShowDialogAsync("Logout realizado com sucesso.", "Sucesso", "/", EDialogStates.Success);
    }

    private void ChangePage(int page)
    {
        currentPage = page;
    }

    private async Task<List<User>> GetUsers()
    {
        var users = await auth.GetUser();

        users.RemoveAll(user => user.Id == app.User.Id);

        return users;
    }

    #endregion
    

    
}
