@using SmartStorage.Shared.VO

@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAuthService auth;

<section class="app-panel app-auth">
    <span class="brand"><i class="brand-mark"></i>Smart Storage</span>
    <div>
        <MudText Typo="Typo.h5" Class="app-page-title">Entrar</MudText>
        <MudText Typo="Typo.body2" Class="app-muted">Use seu login e senha para acessar o estoque.</MudText>
    </div>

    @if (loading)
    {
        <Loading Message="Entrando..." Shape="ELoadingShape.Form"></Loading>
    }
    else
    {
        <form class="app-auth-form" @onsubmit="Sigin">
            <MudTextField @bind-Value="user.Username" T="string" Label="Login" Required="true" RequiredError="Insira o Login" Immediate="true" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="user.Password" T="string" Label="Senha" InputType="InputType.Password" RequiredError="Insira a Senha" Required="true" Immediate="true" Variant="Variant.Outlined" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">Entrar</MudButton>
        </form>
    }
</section>

@code {

    #region Properties

    UserVO user = new();

    bool loading = false;

    #endregion

    #region Methods

    private async Task Sigin()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(user.Username) || string.IsNullOrWhiteSpace(user.Password))
                return;

            loading = true;

            await auth.Login(user);

            //app.User = await api.GetUserByUsername(user.Username);

            await ShowDialog.ShowDialogAsync("Login realizado com sucesso.", "Sucesso", "/", EDialogStates.Success);

            StateHasChanged();
        }
        catch (ApiException ex)
        {
            loading = false;

            var mensagem = $"Falha no login.\n";

            if (ex.Message.Contains("Unauthorized"))
                mensagem += "Usuário ou senha incorreto(s).";
            else
                mensagem += ex.Message;

            StateHasChanged();

            await ShowDialog.ShowDialogAsync(mensagem, title:"Erro", navigate:"/", state: EDialogStates.Warning);
        }
        catch(Exception ex)
        {
            await ShowDialog.ShowDialogAsync(ex.Message, title: "Erro", navigate: "/", state: EDialogStates.Warning);
        }
        finally
        {
            loading = false;
        }
    }

    #endregion

}