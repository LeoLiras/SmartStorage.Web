@page "/user/edit/{userId:long}"

@attribute [Authorize]

@using System.Security.Claims
@using SmartStorage.Shared.Enum
@using SmartStorage.Shared.VO
@using SmartStorage.Shared.Validation

@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAuthService auth
@inject AuthenticationStateProvider authProvider

@if (loading)
{
    <Loading Message="Carregando..." Shape="ELoadingShape.Form"></Loading>
}
else
{
    <section class="app-panel app-form-narrow mt-4">
        <MudText Typo="Typo.subtitle1" Class="app-panel-title">Dados do usuário</MudText>
        <MudForm @ref="form" Model="user">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="user.FullName" T="string" Label="Nome Completo" Required="true" RequiredError="O Nome é obrigatório!" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Value="user.Username" Label="Login" ReadOnly="true" Class="app-readonly" Variant="Variant.Outlined" />
                </MudItem>
                @* O my-account não recebe papel: o próprio papel só muda por outro administrador. *@
                @if (isAdm && !ownAccount)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Class="app-muted">Tipo da conta</MudText>
                        <MudRadioGroup @bind-Value="user.Type" T="TipoUsuario" Required="true" RequiredError="O Tipo da Conta é obrigatório!">
                            <MudRadio Value=TipoUsuario.Usuario Color="Color.Primary">Usuário</MudRadio>
                            <MudRadio Value=TipoUsuario.Administrador Color="Color.Primary">Administrador</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                }
                @if (ownAccount)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="currentPassword" T="string" Label="Senha atual" HelperText="Obrigatória para salvar a conta." InputType="InputType.Password" Required="true" RequiredError="A senha atual é obrigatória!" Variant="Variant.Outlined" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="newPassword" T="string" Label="Nova senha" HelperText="@($"{(ownAccount ? "Deixe em branco para manter a atual." : "Preencha só para redefinir a senha.")} {PasswordPolicy.RuleMessage}")" InputType="InputType.Password" Validation="@(new Func<string, string>(NewPasswordStrength))" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="confirmPassword" T="string" Label="Confirmar nova senha" HelperText="Repita a nova senha." InputType="InputType.Password" Validation="@(new Func<string, string>(PasswordMatch))" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudButton OnClick="UpdateUser" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </section>
}

@code {

    #region Properties

    [Parameter]
    public long UserId { get; set; }

    public bool isAdm { get; set; }

    public UserAccountVO user { get; set; } = new();

    MudForm form;

    string currentPassword;
    string newPassword;
    string confirmPassword;

    bool loading = false;

    bool ownAccount => UserId == app.User.Id;

    #endregion

    #region Events

    protected override async Task OnInitializedAsync()
    {
        var authState = await authProvider.GetAuthenticationStateAsync();
        var userAuth = authState.User;

        isAdm = userAuth?.FindFirst(ClaimTypes.Role)?.Value == "Administrador" ? true : false;

        // A busca por id só aceita administrador: a própria conta, que a tela Conta
        // embute para qualquer usuário, vem do my-account.
        user = ownAccount
            ? await auth.GetMyAccount()
            : await auth.GetUser(UserId);

    }

    #endregion

    #region Methods

    private async void UpdateUser()
    {
        try
        {
            await form.Validate();

            if (!form.IsValid || user is null || string.IsNullOrWhiteSpace(user.FullName))
                return;

            loading = true;

            if (ownAccount)
            {
                app.User = await auth.UpdateMyAccount(new MyAccountUpdateVO
                {
                    FullName = user.FullName,
                    CurrentPassword = currentPassword,
                    NewPassword = newPassword
                });
            }
            else
            {
                await auth.EditUser(user.Id, new UserUpdateVO { FullName = user.FullName, Type = user.Type });

                if (!string.IsNullOrWhiteSpace(newPassword))
                    await auth.SetUserPassword(user.Id, new UserPasswordVO { NewPassword = newPassword });
            }

            await ShowDialog.ShowDialogAsync("Usuário atualizado com sucesso.", "Sucesso", "user/account", EDialogStates.Success);

            StateHasChanged();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            StateHasChanged();

            await ShowDialog.ShowDialogAsync($"Falha atualizando o usuário.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    // Em branco é válido: a senha nova é opcional e só é conferida quando preenchida.
    private string NewPasswordStrength(string pw)
        => string.IsNullOrEmpty(pw) ? null : PasswordPolicy.Validate(pw);

    private string PasswordMatch(string arg)
    {
        if ((newPassword ?? "") != (arg ?? ""))
            return "As senhas não conferem";

        return null;
    }

    #endregion
}
