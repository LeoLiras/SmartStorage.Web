@page "/user/edit/{userId:long}"

@attribute [Authorize]

@using System.Security.Claims
@using SmartStorage.Shared.Enum
@using SmartStorage.Shared.VO

@inject ShowDialog ShowDialog
@inject VariablesExtensions app
@inject IAuthService auth
@inject AuthenticationStateProvider authProvider

@if (loading)
{
    <Loading Message="Carregando..." Shape="ELoadingShape.Form"></Loading>
}
else
{
    <section class="app-panel app-form-narrow mt-4">
        <MudText Typo="Typo.subtitle1" Class="app-panel-title">Dados do usuário</MudText>
        <MudForm Model="user">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="user.FullName" T="string" Label="Nome Completo" Required="true" RequiredError="O Nome é obrigatório!" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Value="user.Username" Label="Login" ReadOnly="true" Class="app-readonly" Variant="Variant.Outlined" />
                </MudItem>
                @if (isAdm)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Class="app-muted">Tipo da conta</MudText>
                        <MudRadioGroup @bind-Value="user.Type" T="TipoUsuario" Required="true" RequiredError="O Tipo da Conta é obrigatório!">
                            <MudRadio Value=TipoUsuario.Usuario Color="Color.Primary">Usuário</MudRadio>
                            <MudRadio Value=TipoUsuario.Administrador Color="Color.Primary">Administrador</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudButton OnClick="UpdateUser" Variant="Variant.Filled" Color="Color.Primary">Atualizar</MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </section>
}

@code {

    #region Properties

    [Parameter]
    public long UserId { get; set; }

    public bool isAdm { get; set; }

    public UserAccountVO user { get; set; } = new();

    bool loading = false;

    #endregion

    #region Events

    protected override async Task OnInitializedAsync()
    {
        var authState = await authProvider.GetAuthenticationStateAsync();
        var userAuth = authState.User;

        isAdm = userAuth?.FindFirst(ClaimTypes.Role)?.Value == "Administrador" ? true : false;

        // A busca por id só aceita administrador: a própria conta, que a tela Conta
        // embute para qualquer usuário, vem do my-account.
        user = UserId == app.User.Id
            ? await auth.GetMyAccount()
            : await auth.GetUser(UserId);

    }

    #endregion

    #region Methods

    private async void UpdateUser()
    {
        try
        {
            if (user is null || string.IsNullOrWhiteSpace(user.FullName))
                return;

            loading = true;

            var result = await auth.EditUser(user);

            await ShowDialog.ShowDialogAsync("Usuário atualizado com sucesso.", "Sucesso", "user/account", EDialogStates.Success);

            StateHasChanged();

            loading = false;
        }
        catch (ApiException ex)
        {
            loading = false;

            await ShowDialog.ShowDialogAsync($"Falha atualizando o usuário.\n{ex.Message}", "Erro", state: EDialogStates.Warning);
        }
    }

    #endregion
}
